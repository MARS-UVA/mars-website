---
const { subteam } = Astro.props;
---

<a
    href={`#${subteam.id}`}
    class="subteam-button"
    style={`background-color: ${subteam.color};`}
>
    {subteam.name}
</a>

<style>
    .subteam-button {
        display: inline-block;
        padding: 9px 18px;
        border-radius: 10px;
        color: white;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 500;
        transition: filter 0.2s ease;
    }

    .subteam-button:hover {
        filter: brightness(0.88);
    }
</style>
