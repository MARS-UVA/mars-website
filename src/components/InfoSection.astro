---
const { imageSrc, imagePosition, center, id } = Astro.props;
---

<section id={id}>
    {
        imagePosition === "left" ? (
            <div class="image">
                <img src={imageSrc} />
            </div>
        ) : null
    }
    <div class={`content ${center ? "center" : ""}`}>
        <slot />
    </div>
    {
        imagePosition === "right" ? (
            <div class="image">
                <img src={imageSrc} />
            </div>
        ) : null
    }
</section>

<style>
    section {
        display: flex;
        align-items: center;
        padding: clamp(30px, 3.5vw, 56px) clamp(20px, 4vw, 56px);
        gap: clamp(20px, 3vw, 40px);
        width: 100%;
        box-sizing: border-box;
        position: relative;
        isolation: isolate;
        background: transparent;
    }

    section::before {
        content: "";
        position: absolute;
        z-index: -1;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        background: #f3f7fc;
    }

    .image {
        flex: 2;
    }

    img {
        object-fit: cover;
        height: 600px;
        width: 100%;
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(16, 35, 66, 0.13);
    }

    .content {
        flex: 2;
        padding: 0;
        width: 100%;
        box-sizing: border-box;
    }

    .content.center {
        text-align: center;
        padding: 0;
    }

    @media (max-width: 768px) {
        section {
            flex-direction: column;
            padding: 20px;
            gap: 20px;
        }

        .image {
            flex: none;
            width: 100%;
        }

        .content {
            flex: none;
            width: 100%;
            padding: 10px;
        }

        img {
            height: 300px;
        }
    }
</style>

<style is:global>
    .content h2 {
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        margin: 0 0 22px;
    }

    .content:not(.center) h2 {
        font-size: clamp(2rem, 3vw, 2.5rem);
    }

    .content p {
        font-size: 1.05rem;
        line-height: 1.65;
    }

    .content ul {
        list-style: disc;
        padding-left: 1.25rem;
        margin: 1.2rem 0 0;
    }

    .content ul li {
        margin: 0.65rem 0;
        font-size: 1.02rem;
        padding-left: 0.3rem;
    }

    .content ul ul {
        margin: 0.5rem 0 0 1rem;
    }

    @media (max-width: 768px) {
        .content h2 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .content p {
            font-size: 1rem;
            line-height: 1.65;
        }

        .content ul li {
            font-size: 1rem;
            margin: 8px 0;
        }

        .content ul ul {
            margin-left: 20px;
        }
    }
</style>
