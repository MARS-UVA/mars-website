---
const {
    addCloseButton,
    id,
    buttonContent,
    buttonAttributes,
    defaultOpen,
    showX,
    width,
} = Astro.props;
---

<>
    {
        buttonContent ? (
            <span class="open-modal" data-id={id} {...buttonAttributes}>
                {buttonContent || "Open Modal"}
            </span>
        ) : null
    }
</>
<div
    class="overlay hidden"
    id={id}
    data-default-open={defaultOpen ? "true" : "false"}
>
    <div class="modal" style={{ maxWidth: width ?? "800px" }}>
        {
            showX ? (
                <button class="close-button x-button" data-id={id}>
                    &times;
                </button>
            ) : null
        }
        <slot />
        {
            addCloseButton ? (
                <button class="close-button bottom-button" data-id={id}>
                    Close
                </button>
            ) : null
        }
    </div>
</div>

<script>
    // Detect document.referrer. If from external site, show defaultOpen modals
    const referrer = document.referrer;
    const modals = document.querySelectorAll(".overlay");
    modals.forEach((modal) => {
        const isDefaultOpen = modal.getAttribute("data-default-open");
        if (
            (referrer === "" || !referrer.includes(window.location.hostname)) &&
            isDefaultOpen === "true"
        ) {
            modal.classList.remove("hidden");
        }
    });

    function closeModal(id: string) {
        const targetOverlay = document.getElementById(id);
        if (targetOverlay) {
            targetOverlay.classList.add("hidden");
        }
    }

    function openModal(id: string) {
        const targetOverlay = document.getElementById(id);
        if (targetOverlay) {
            targetOverlay.classList.remove("hidden");
        }
    }

    const overlays = document.querySelectorAll(".overlay");
    overlays.forEach((overlay) => {
        overlay.addEventListener("click", (e) => {
            if (e.target === overlay) {
                closeModal(overlay.id);
            }
        });
    });

    const closeButtons = document.querySelectorAll(".close-button");
    closeButtons.forEach((button) => {
        button.addEventListener("click", (e) => {
            e.stopPropagation();
            closeModal(button.getAttribute("data-id") || "");
        });
    });

    const openButtons = document.querySelectorAll(".open-modal");
    openButtons.forEach((button) => {
        button.addEventListener("click", (e) => {
            e.stopPropagation();
            openModal(button.getAttribute("data-id") || "");
        });
    });
</script>

<style>
    .overlay.hidden {
        display: none;
    }

    .overlay {
        z-index: 1001;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(11, 22, 42, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal {
        background-color: white;
        padding: 36px;
        border-top: 4px solid #e57200;
        border-radius: 10px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.32);
        font-size: 1rem;
        line-height: 1.7;
        position: relative;
        max-height: calc(100vh - 48px);
        overflow-y: auto;
    }

    .x-button {
        position: absolute;
        top: 12px;
        right: 14px;
        background: transparent;
        border: none;
        font-size: 1.8rem;
        color: #222b48;
        cursor: pointer;
    }

    .bottom-button {
        display: block;
        width: 136px;
        height: 46px;
        margin: 24px auto 0;
        padding: 10px 20px;
        background-color: #222b48;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        box-sizing: border-box;
        transition: background-color 0.3s ease;
    }

    .open-modal {
        cursor: pointer;
    }

    .bottom-button:hover {
        background-color: #e57200;
    }

    @media (max-width: 600px) {
        .modal {
            width: calc(100% - 32px);
            padding: 28px 22px;
        }
    }
</style>
