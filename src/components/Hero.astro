---
import { Image } from "astro:assets";
import HeroPicture from "../assets/images/Hero.png";
---

<section class="hero">
    <div class="parallax">
        <Image
            class="background"
            src={HeroPicture}
            alt="MARS Team"
            loading="lazy"
        />
    </div>
    <div class="main-title">
        <h1>MARS at UVA</h1>
        <h3>Mechatronics and Robotics Society</h3>
        <h2>2026 NASA Lunabotics Champions</h2>
    </div>
</section>

<style>
    .hero {
        position: relative;
        width: 100%;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        color: white;
        overflow: hidden;
        z-index: 0;
    }

    .background {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* animation: pan 90s ease-in-out infinite; */
        /* animation-delay: -22.5s; */
        object-position: bottom center;
    }

    .parallax {
        position: relative;
        width: 100%;
        height: 100%;
        z-index: -1;
        transform-style: preserve-3d;
    }

    @media screen and (max-height: 600px) {
        .background {
            animation: none;
            transform: none;
            min-width: auto;
            object-fit: cover;
            width: 100%;
        }
    }

    @keyframes pan {
        0%,
        100% {
            transform: translateX(-50%);
        }

        50% {
            transform: translateX(0%);
        }
    }

    .main-title {
        position: absolute;
        top: 0;
        bottom: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 1;
        background: rgba(0, 0, 0, 0.6);
        padding: 100px;
        padding-bottom: 20px;
        text-align: center;
        width: 100%;
        height: 100vh;
    }

    .main-title h1 {
        font-size: 5rem;
        margin: 0;
        font-weight: bold;
    }

    .main-title h2 {
        font-size: 2rem;
        margin-top: 30px;
        font-weight: normal;
    }

    .main-title h3 {
        font-size: 1.75rem;
        margin: 0;
    }
</style>
