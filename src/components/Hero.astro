---
import { Image } from "astro:assets";
import HeroPicture from "../assets/images/Hero.png";
---

<section class="hero">
    <div class="parallax">
        <Image
            class="background"
            src={HeroPicture}
            alt="MARS Team"
            loading="lazy"
        />
    </div>
    <div class="main-title">
        <h1>MARS at UVA</h1>
        <h3>Mechatronics and Robotics Society</h3>
        <h2>2026 NASA Lunabotics Champions</h2>
    </div>
    <button class="hero-scroll" type="button" aria-label="Scroll to main content">↓</button>
</section>

<script>
    document.querySelector(".hero-scroll")?.addEventListener("click", () => {
        window.scrollTo({ top: window.innerHeight, behavior: "smooth" });
    });
</script>

<style>
    .hero {
        position: relative;
        width: 100%;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: start;
        color: white;
        overflow: hidden;
        z-index: 0;
    }

    .hero-scroll {
        position: absolute;
        z-index: 2;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        width: 44px;
        height: 44px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 50%;
        background: rgba(11, 22, 42, 0.38);
        color: #fff;
        font-family: inherit;
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .hero-scroll:hover {
        background: #e57200;
        transform: translateX(-50%) translateY(3px);
    }

    .background {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* animation: pan 90s ease-in-out infinite; */
        /* animation-delay: -22.5s; */
        object-position: bottom center;
    }

    .parallax {
        position: relative;
        width: 100%;
        height: 100%;
        z-index: -1;
        transform-style: preserve-3d;
    }

    @media screen and (max-height: 600px) {
        .background {
            animation: none;
            transform: none;
            min-width: auto;
            object-fit: cover;
            width: 100%;
        }
    }

    @keyframes pan {
        0%,
        100% {
            transform: translateX(-50%);
        }

        50% {
            transform: translateX(0%);
        }
    }

    .main-title {
        position: absolute;
        top: 0;
        bottom: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 1;
        background: linear-gradient(
            90deg,
            rgba(11, 22, 42, 0.82),
            rgba(11, 22, 42, 0.4)
        );
        padding: 100px clamp(24px, 9vw, 150px) 20px;
        text-align: center;
        width: 100%;
        height: 100vh;
    }

    .main-title h1 {
        font-size: clamp(3.5rem, 8vw, 6.5rem);
        margin: 0;
        font-weight: 700;
        color: white;
        text-align: center;
    }

    .main-title h2 {
        font-family: "Inter", sans-serif;
        font-size: clamp(1rem, 2vw, 1.35rem);
        margin-top: 34px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #f3b56b;
        text-align: center;
    }

    .main-title h3 {
        font-family: "Inter", sans-serif;
        font-size: clamp(1.1rem, 2.4vw, 1.55rem);
        margin: 0;
        font-weight: 500;
        color: #fff;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
        text-align: center;
    }
</style>
