---
const { title, icon } = Astro.props;
---

<div class="info-tile">
    <div
        style="display: flex; align-items: center; justify-content: space-between;"
    >
        <h3>{title}</h3>
        <div class="icon">{icon}</div>
    </div>
    <p><slot /></p>
</div>

<style>
    .info-tile {
        width: 100%;
        background-color: #fff;
        box-shadow: 0 8px 24px rgba(17, 35, 65, 0.1);
        border: 1px solid #dbe1e9;
        border-top: 4px solid #e57200;
        padding: 30px;
        border-radius: 10px;
        box-sizing: border-box;
    }
</style>
<style is:global>
    .info-tile h3 {
        font-size: 1.9rem;
        text-align: left;
        margin: 0;
    }

    .info-tile p {
        text-align: start;
        line-height: 1.65;
    }

    .info-tile .icon {
        font-size: 2rem;
        text-align: left;
    }

    @media (max-width: 768px) {
        .info-tile {
            padding: 15px 20px;
            border-radius: 30px;
        }

        .info-tile h3 {
            font-size: 1.5rem;
        }

        .info-tile .icon {
            font-size: 2rem;
            margin-top: -10px;
        }

        .info-tile p {
            font-size: 0.9rem;
            line-height: 1.4;
        }
    }
</style>
