---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
	folder?: string;
	width?: string;
	height?: string;
}

const {
	folder = "gallery",
	width = "1100px",
	height = "620px",
} = Astro.props;
const folderPath = folder.replace(/^\/+|\/+$/g, "");
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/images/**/*.{jpg,jpeg,png,webp}",
);

const photos = await Promise.all(
	Object.entries(imageModules)
		.filter(([path]) => {
			const relativePath = path.replace("../assets/images/", "");
			return relativePath.substring(0, relativePath.lastIndexOf("/")) === folderPath;
		})
		.sort(([pathA], [pathB]) =>
			pathA.localeCompare(pathB, undefined, { numeric: true }),
		)
		.map(async ([path, load], index) => {
			const module = await load();
			const fileName = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
			const alt = fileName
				.replace(/^\d+[-_\s]*/, "")
				.replace(/[-_]+/g, " ")
				.trim();

			return {
				image: module.default,
				alt: alt || `Photo ${index + 1}`,
			};
		}),
);
---

{
	photos.length > 0 && (
		<div class="gallery-row">
			<div
				class="photo-gallery"
				style={`--gallery-width: ${width}; --gallery-height: ${height};`}
			>
				<div class="gallery" data-gallery>
					<div class="slides" aria-live="off">
						{photos.map(({ image, alt }, index) => (
							<figure class:list={["slide", { active: index === 0 }]} aria-hidden={index !== 0}>
								<Image src={image} alt={alt} />
							</figure>
						))}
					</div>
					<div class="controls" role="group" aria-label="Gallery navigation">
						<button type="button" class="previous" aria-label="Previous photo">
							<span aria-hidden="true"></span>
						</button>
						<button type="button" class="next" aria-label="Next photo">
							<span aria-hidden="true"></span>
						</button>
					</div>
				</div>
			</div>
			<slot />
		</div>
	)
}

<script>
	const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	galleries.forEach((gallery) => {
		const slides = Array.from(
			gallery.querySelectorAll<HTMLElement>(".slide"),
		);
		const previous = gallery.querySelector<HTMLButtonElement>(".previous");
		const next = gallery.querySelector<HTMLButtonElement>(".next");

		if (slides.length < 2 || !previous || !next) {
			if (previous) previous.hidden = true;
			if (next) next.hidden = true;
			return;
		}

		let current = 0;
		let timer: number | undefined;

		const showSlide = (index: number) => {
			slides[current].classList.remove("active");
			slides[current].setAttribute("aria-hidden", "true");
			current = (index + slides.length) % slides.length;
			slides[current].classList.add("active");
			slides[current].setAttribute("aria-hidden", "false");
		};

		const updateTimer = () => {
			window.clearInterval(timer);
			timer = !document.hidden && !reducedMotion.matches
				? window.setInterval(() => showSlide(current + 1), 5000)
				: undefined;
		};

		previous.addEventListener("click", () => {
			showSlide(current - 1);
		});
		next.addEventListener("click", () => {
			showSlide(current + 1);
		});

		document.addEventListener("visibilitychange", updateTimer);
		updateTimer();
	});
</script>

<style>
	.gallery-row {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		padding: 10px 0;
	}

	.gallery-row::before {
		content: "";
		position: absolute;
		z-index: -1;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 100vw;
		transform: translateX(-50%);
		background: #f3f7fc;
	}

	.photo-gallery {
		flex: 0 1 var(--gallery-width);
		width: var(--gallery-width);
		height: var(--gallery-height);
		max-width: 100%;
		min-width: 0;
	}

	.gallery {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.slides {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 10px;
		background: #172033;
	}

	.slide {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 600ms ease, visibility 600ms ease;
	}

	.slide.active {
		opacity: 1;
		visibility: visible;
	}

	.slide :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.controls {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 12px;
		pointer-events: none;
	}

	.controls button {
		display: grid;
		width: 48px;
		height: 64px;
		place-items: center;
		border: 0;
		border-radius: 4px;
		background: rgb(23 32 51 / 0%);
		cursor: pointer;
		pointer-events: auto;
		transition: background-color 180ms ease;
	}

	.controls button:hover {
		background: rgb(23 32 51 / 75%);
	}

	.controls button span {
		width: 14px;
		height: 14px;
		border-top: 3px solid #fff;
		border-right: 3px solid #fff;
		transform: translateX(-3px) rotate(45deg);
	}

	.controls .previous span {
		transform: translateX(3px) rotate(225deg);
	}

	.controls button:focus-visible {
		outline: 3px solid #e57200;
		outline-offset: 2px;
	}

	@media (max-width: 768px) {
		.gallery-row {
			flex-direction: column;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.slide {
			transition: none;
		}

		.controls button {
			transition: none;
		}
	}
</style>
