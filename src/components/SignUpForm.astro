---
import ActionSection from "./ActionSection.astro";
---

<style>
  h3 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 0.5rem;
    margin-top: 1rem;
  }

  label {
    font-weight: bold;
    font-size: 0.78rem;
    display: block;
    position: absolute;
    top: -0.62rem;
    left: 10px;
    padding: 0 5px;
    color: #40506a;
    background: #fff;
    letter-spacing: 0.02em;
  }

  input[type="email"] {
    width: 100%;
    margin: 0;
    height: auto;
    outline: none;
    padding: 13px 12px 9px;
    text-indent: 0%;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #8b96a8;
    box-sizing: border-box;
  }

  .button {
    color: white;
    font-size: 1.1rem;
    display: block;
    border: none;
    appearance: none;
    border-radius: 8px;
    width: 136px;
    align-self: center;
    cursor: pointer;
    box-sizing: border-box;
    margin: auto 0 0;
    height: 46px;
    font-family: inherit;
    background-color: #222b48;
    padding: 10px 20px;
    transition: background-color 0.3s ease;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
  }

  .mc-field-group {
    position: relative;
    padding-top: 4px;
  }

  .button:hover {
    background-color: #e57200;
  }
</style>

<ActionSection>
  <form
    action="https://marsatuva.us6.list-manage.com/subscribe/post?u=e4373a6764c06e5221396c3b9&id=12e1c200fd&f_id=004809e3f0"
    method="post"
    target="_blank"
    novalidate
  >
    <h3>Subscribe to the MARS Newsletter</h3>

    <div class="mc-field-group">
      <label for="mce-EMAIL">Email Address:</label>
      <input
        type="email"
        name="EMAIL"
        id="mce-EMAIL"
        class="required email"
        required
      />
    </div>

    <!-- Honeypot anti-bot field -->
    <div style="position: absolute; left: -5000px;" aria-hidden="true">
      <input
        type="text"
        name="b_e4373a6764c06e5221396c3b9_12e1c200fd"
        tabindex="-1"
        value=""
      />
    </div>

    <input type="submit" name="subscribe" class="button" value="Subscribe" />
  </form>
</ActionSection>
